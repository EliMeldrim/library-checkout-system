@page
@model LibraryCheckout.Web.Pages.Members.CreateModel
@{
    ViewData["Title"] = "New Member";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">Members</a></li>
        <li class="breadcrumb-item active" aria-current="page">New Member</li>
    </ol>
</nav>

<h1 class="page-heading">New Member</h1>

<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Name"></label>
                <input class="form-control" asp-for="Input.Name" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Email"></label>
                <input class="form-control" asp-for="Input.Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.JoinDate"></label>
                <input class="form-control" asp-for="Input.JoinDate" />
                <span asp-validation-for="Input.JoinDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Status"></label>
                <select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<MemberStatus>()"></select>
                <span asp-validation-for="Input.Status" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-library">Create Member</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
